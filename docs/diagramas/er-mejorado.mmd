    usuarios ||--o| estudiantes : "perfil"
    usuarios ||--o| coordinadores : "perfil"
    usuarios ||--o| decanos : "perfil"
    usuarios ||--o{ password_reset_tokens : "solicita"

    %% ===== Estructura organizacional =====
    facultades ||--o{ departamentos : "contiene"
    facultades ||--o{ carreras : "agrupa"
    facultades ||--o| decanos : "dirigida por"
    departamentos ||--o{ carreras : "administra"
    departamentos ||--o{ profesores : "adscribe"
    carreras ||--o{ coordinadores : "coordinada por"
    carreras ||--o{ estudiantes : "matricula"
    carreras ||--o{ cursos : "ofrece"

