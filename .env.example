# Plantilla de variables de entorno. Copiala con: cp .env.example .env
# Nunca pongas valores reales en este archivo: se sube a GitHub.

# --- Servidor ---
PORT=3000
NODE_ENV=development

# Origenes del front que pueden llamar a la API, separados por coma.
# Vacio = cualquier origen (solo para pruebas).
CORS_ORIGIN=http://localhost:3001,http://localhost:8081

# URL del front que va dentro de los correos (recuperacion de clave y QR).
FRONTEND_URL=http://localhost:3001

# --- Supabase ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# --- Autenticacion ---
JWT_SECRET=un_secreto_largo_y_aleatorio
BCRYPT_SALT_ROUNDS=12

# --- Correo ---
# Opcion recomendada: API HTTPS de Brevo (puerto 443). Si BREVO_API_KEY tiene valor,
# se usa la API y se ignoran SMTP_HOST/PORT/SECURE/USER/PASS.
# La clave empieza por xkeysib- (no la clave SMTP xsmtpsib-).
BREVO_API_KEY=tu_api_key_de_brevo

# Remitente: debe estar verificado en Brevo. Lo usan tanto la API como SMTP.
# Sin comillas: docker run --env-file no las quita y quedarian dentro del valor.
SMTP_FROM=EntreAulas <tu_correo_verificado@gmail.com>

# Alternativa SMTP: solo se usa si BREVO_API_KEY esta vacia.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Solo desarrollo: devuelve el token de recuperacion en la respuesta.
PASSWORD_RESET_DEBUG_RESPONSE=false

# --- IA (opcional) ---
GOOGLE_GEMINI_API_KEY=tu_api_key_de_gemini
